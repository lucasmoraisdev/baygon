# Ambiente da Aplicação (development ou production)
ENVIRONMENT=development

# Conexão com o Banco de Dados
# O sistema tenta ler primeiro do '.streamlit/secrets.toml'. 
# Caso não encontre, ele utiliza esta variável de ambiente.
# Formato: dialect+driver://username:password@host:port/database
DATABASE_URL=mysql+aiomysql://usuario:senha@localhost:3306/baygon_db

# NOTA: O restante das configurações de segurança (SECRET_KEY, EMAIL_CONFIG, ENCODING)
# estão sendo carregadas pelo arquivo '.streamlit/secrets.toml' conforme configuração atual.

# Extração de Súmula por Imagem (padrão: auto -> usa Ollama se configurado, senão Gemini/OpenAI, senão RapidOCR local open-source)
# SUMULA_VISION_PROVIDER=auto
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl
# GEMINI_API_KEY=
# OPENAI_API_KEY=
